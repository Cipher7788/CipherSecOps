# ── Stage 1: development ──────────────────────────────────────────────────────
# Used by docker-compose for the live-reload dev server.
FROM node:18-alpine AS development

WORKDIR /app

COPY dashboard/package*.json ./
RUN npm ci

COPY dashboard/ ./

EXPOSE 3000
CMD ["npm", "start"]

# ── Stage 2: builder ──────────────────────────────────────────────────────────
# Produces an optimised production build.
FROM node:18-alpine AS builder

WORKDIR /app

COPY dashboard/package*.json ./
RUN npm ci --omit=dev

COPY dashboard/ ./

ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

RUN npm run build

# ── Stage 3: production (default) ─────────────────────────────────────────────
# Lightweight nginx image that serves the static build artefacts.
FROM nginx:alpine AS production

# Copy custom nginx config for client-side routing support
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location /health {\n\
        return 200 "ok";\n\
        add_header Content-Type text/plain;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
