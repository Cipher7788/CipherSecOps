# CipherSecOps – Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ciphersecops:changeme@localhost:5432/ciphersecops

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Server ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# ── Threat intelligence API keys ──────────────────────────────────────────────
ALIENVAULT_API_KEY=your-alienvault-otx-api-key-here
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# ── Agent ─────────────────────────────────────────────────────────────────────
# URL of the CipherSecOps server the agent reports to
SERVER_URL=http://localhost:8000
# Unique identifier for this agent instance (auto-generated if left blank)
AGENT_ID=

# ── React Dashboard ───────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
